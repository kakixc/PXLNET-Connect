+// ProbeServer creates an isolated Hysteria2 client and completes its QUIC and
+// authentication handshake without touching the live outbound client.
+func (h *Outbound) ProbeServer(ctx context.Context) error {
+	if h.probeUnsupported != "" {
+		return E.New("server probe is not supported with ", h.probeUnsupported)
+	}
+	tlsConfig, err := tls.NewClient(ctx, h.logger, h.tlsServerAddress, h.tlsOptions)
+	if err != nil {
+		return E.Cause(err, "create probe TLS config")
+	}
+	clientOptions := h.probeClientOptions
+	clientOptions.Context = ctx
+	clientOptions.TLSConfig = tlsConfig
+	client, err := hysteria2.NewClient(clientOptions)
+	if err != nil {
+		return E.Cause(err, "create probe client")
+	}
+	defer client.CloseWithError(os.ErrClosed)
+	// DialConn authenticates the fresh QUIC session before returning. Closing
+	// this unopened stream sends no destination request and works even when
+	// Hysteria2 UDP forwarding is disabled on the server.
+	conn, err := client.DialConn(ctx, M.Socksaddr{})
+	if err != nil {
+		return err
+	}
+	return conn.Close()
+}
