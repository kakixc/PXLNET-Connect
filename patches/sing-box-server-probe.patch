diff --git a/daemon/pxlnet_server_probe.go b/daemon/pxlnet_server_probe.go
new file mode 100644
index 0000000..162c192
--- /dev/null
+++ b/daemon/pxlnet_server_probe.go
@@ -0,0 +1,44 @@
+package daemon
+
+import (
+	"context"
+	"time"
+
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+)
+
+// ProbeServer measures one fresh protocol handshake without changing URL-test
+// history or the currently selected outbound. Only explicitly supported
+// outbounds expose this optional method.
+func (s *StartedService) ProbeServer(ctx context.Context, outboundTag string) (int32, error) {
+	if outboundTag == "" {
+		return 0, status.Error(codes.InvalidArgument, "empty outbound tag")
+	}
+	s.serviceAccess.RLock()
+	if s.serviceStatus.Status != ServiceStatus_STARTED || s.instance == nil {
+		s.serviceAccess.RUnlock()
+		return 0, status.Error(codes.FailedPrecondition, "service is not started")
+	}
+	outbound, loaded := s.instance.outboundManager.Outbound(outboundTag)
+	s.serviceAccess.RUnlock()
+	if !loaded {
+		return 0, status.Error(codes.NotFound, "outbound not found")
+	}
+	prober, supported := outbound.(interface{ ProbeServer(context.Context) error })
+	if !supported {
+		return 0, status.Error(codes.Unimplemented, "outbound does not support server probe")
+	}
+	start := time.Now()
+	if err := prober.ProbeServer(ctx); err != nil {
+		return 0, err
+	}
+	delay := time.Since(start).Milliseconds()
+	if delay < 1 {
+		delay = 1
+	}
+	if delay > 60_000 {
+		return 0, status.Error(codes.DeadlineExceeded, "server probe exceeded limit")
+	}
+	return int32(delay), nil
+}
diff --git a/experimental/libbox/pxlnet_server_probe_rpc.go b/experimental/libbox/pxlnet_server_probe_rpc.go
new file mode 100644
index 0000000..71812be
--- /dev/null
+++ b/experimental/libbox/pxlnet_server_probe_rpc.go
@@ -0,0 +1,75 @@
+package libbox
+
+import (
+	"context"
+	"time"
+
+	"github.com/sagernet/sing-box/daemon"
+	"google.golang.org/grpc"
+	"google.golang.org/protobuf/types/known/wrapperspb"
+)
+
+const serverProbeMethod = "/pxlnet.ServerProbe/Probe"
+
+type serverProbeService interface {
+	probe(context.Context, *wrapperspb.StringValue) (*wrapperspb.Int32Value, error)
+}
+
+type serverProbeHandler struct {
+	started *daemon.StartedService
+}
+
+func (h *serverProbeHandler) probe(ctx context.Context, request *wrapperspb.StringValue) (*wrapperspb.Int32Value, error) {
+	delay, err := h.started.ProbeServer(ctx, request.Value)
+	if err != nil {
+		return nil, err
+	}
+	return wrapperspb.Int32(delay), nil
+}
+
+func serverProbeUnaryHandler(
+	server any,
+	ctx context.Context,
+	decode func(any) error,
+	interceptor grpc.UnaryServerInterceptor,
+) (any, error) {
+	request := new(wrapperspb.StringValue)
+	if err := decode(request); err != nil {
+		return nil, err
+	}
+	handler := func(ctx context.Context, request any) (any, error) {
+		return server.(serverProbeService).probe(ctx, request.(*wrapperspb.StringValue))
+	}
+	if interceptor == nil {
+		return handler(ctx, request)
+	}
+	return interceptor(ctx, request, &grpc.UnaryServerInfo{Server: server, FullMethod: serverProbeMethod}, handler)
+}
+
+var serverProbeServiceDesc = grpc.ServiceDesc{
+	ServiceName: "pxlnet.ServerProbe",
+	HandlerType: (*serverProbeService)(nil),
+	Methods:     []grpc.MethodDesc{{MethodName: "Probe", Handler: serverProbeUnaryHandler}},
+}
+
+// ProbeServer returns one sample in milliseconds. The socket uses the same
+// private, authenticated command channel as other libbox control calls.
+func (c *CommandClient) ProbeServer(outboundTag string) (int32, error) {
+	_, callCtx, err := c.getClientForCall()
+	if err != nil {
+		return 0, err
+	}
+	if c.standalone {
+		defer c.closeConnection()
+	}
+	c.clientMutex.RLock()
+	connection := c.grpcConn
+	c.clientMutex.RUnlock()
+	ctx, cancel := context.WithTimeout(callCtx, 6*time.Second)
+	defer cancel()
+	response := new(wrapperspb.Int32Value)
+	if err := connection.Invoke(ctx, serverProbeMethod, wrapperspb.String(outboundTag), response); err != nil {
+		return 0, err
+	}
+	return response.Value, nil
+}
